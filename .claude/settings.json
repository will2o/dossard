{
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Edit(./.env)",
      "Edit(./.env.*)",
      "Write(./.env)",
      "Write(./.env.*)",
      "Edit(./scripts/legacy/**)",
      "Bash(cat *.env*)",
      "Bash(head *.env*)",
      "Bash(tail *.env*)",
      "Bash(less *.env*)",
      "Bash(more *.env*)",
      "Bash(grep *.env*)",
      "Bash(rg *.env*)",
      "Bash(sed *.env*)",
      "Bash(awk *.env*)",
      "Bash(cut *.env*)",
      "Bash(sort *.env*)",
      "Bash(cp *.env*)",
      "Bash(mv *.env*)",
      "Bash(source *.env*)",
      "Bash(. *.env*)",
      "Bash(env)",
      "Bash(printenv*)"
    ],
    "allow": ["mcp__dossard__list_views"],
    "ask": ["mcp__dossard__query_view"]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/garde.py\"",
            "onFailure": "block"
          }
        ]
      },
      {
        "matcher": "mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/journal_mcp.py\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/formate.py\""
          }
        ]
      }
    ]
  }
}
