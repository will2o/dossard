{
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Edit(./.env)",
      "Edit(./.env.*)",
      "Write(./.env)",
      "Write(./.env.*)",
      "Edit(./scripts/legacy/**)",
      "Bash(cat *.env*)",
      "Bash(head *.env*)",
      "Bash(tail *.env*)",
      "Bash(less *.env*)",
      "Bash(more *.env*)",
      "Bash(grep *.env*)",
      "Bash(rg *.env*)",
      "Bash(sed *.env*)",
      "Bash(awk *.env*)",
      "Bash(cut *.env*)",
      "Bash(sort *.env*)",
      "Bash(cp *.env*)",
      "Bash(mv *.env*)",
      "Bash(source *.env*)",
      "Bash(. *.env*)",
      "Bash(env)",
      "Bash(printenv*)"
    ],
    "allow": ["mcp__plugin_dossard-equipe_dossard__list_views"],
    "ask": ["mcp__plugin_dossard-equipe_dossard__query_view"]
  },
  "extraKnownMarketplaces": {
    "equipe-dossard": {
      "source": { "source": "directory", "path": "." }
    }
  },
  "enabledPlugins": {
    "dossard-equipe@equipe-dossard": true
  }
}
